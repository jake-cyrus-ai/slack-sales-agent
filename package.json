{
  "name": "slack-sales-agent-harness",
  "description": "Slack-native open-source sales agent platform with durable workflows, direct integrations, approvals, preferences, and autonomous email policies",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx --env-file=.env.development --watch server/index.ts",
    "dev:server:local": "tsx --watch scripts/dev-server-local.ts",
    "dev:inngest": "pnpm dlx inngest-cli@latest dev -u http://localhost:3001/api/inngest",
    "dev:all": "concurrently \"pnpm run dev\" \"pnpm run dev:server\" \"pnpm run dev:inngest\"",
    "dev:all:local": "concurrently \"pnpm run dev\" \"pnpm run dev:server:local\" \"pnpm run dev:inngest\"",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:dev": "vite build --mode development",
    "build:server": "npx esbuild server/index.ts --bundle --platform=node --target=node20 --outdir=server/dist --format=esm --packages=external",
    "build:server:check": "tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:server": "node server/dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:inngest": "vitest run --config server/inngest/__tests__/vitest.config.ts --dir server/inngest/__tests__",
    "test:tools": "SUPABASE_URL=http://localhost:54321 SUPABASE_SERVICE_ROLE_KEY=test ANTHROPIC_API_KEY=test OPENAI_API_KEY=test tsx --test server/src/services/safe-calendar-client.test.ts server/src/attio/tools/__tests__/tools.test.ts server/src/salesforce/tools/__tests__/tools.test.ts",
    "test:slack-message": "tsx scripts/test/send-mock-slack-message.ts",
    "test:slack-interaction": "tsx scripts/test/send-mock-slack-interaction.ts",
    "test:inngest-trigger": "tsx scripts/test/trigger-inngest-function.ts",
    "test:seed": "tsx --env-file=.env.development scripts/test/seed-test-data.ts",
    "test:seed-features": "tsx --env-file=.env.development scripts/test/seed-feature-data.ts",
    "test:trigger-meeting": "tsx scripts/test/trigger-meeting-followup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@browserbasehq/sdk": "^2.16.0",
    "@clerk/backend": "^2.33.6",
    "@clerk/express": "^1.7.82",
    "@langchain/anthropic": "^1.5.3",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.9",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@slack/bolt": "^4.7.3",
    "@slack/web-api": "^7.19.0",
    "@supabase/supabase-js": "^2.112.1",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "exa-js": "^1.10.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.4.0",
    "helmet": "^8.3.0",
    "inngest": "^3.54.2",
    "jsforce": "^3.10.19",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svix": "^1.99.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "happy-dom": "^20.11.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
