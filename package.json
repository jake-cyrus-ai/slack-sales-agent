{
  "name": "slack-sales-agent",
  "description": "Slack-native open-source sales agent platform with durable workflows, direct integrations, approvals, preferences, and autonomous email policies",
  "private": false,
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jake-cyrus-ai/slack-sales-agent.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx --env-file=.env --watch server/index.ts",
    "dev:server:local": "tsx --watch scripts/dev-server-local.ts",
    "dev:vercel": "nitro dev",
    "dev:all": "pnpm run dev:vercel",
    "dev:all:local": "pnpm run dev:vercel",
    "build": "vite build && nitro build",
    "build:staging": "vite build --mode staging",
    "build:dev": "vite build --mode development",
    "build:server": "npx esbuild server/index.ts --bundle --platform=node --target=node20 --outdir=server/dist --format=esm --packages=external",
    "build:server:check": "tsc -p server/tsconfig.json --noEmit",
    "build:workflows": "nitro build",
    "check:workflows": "workflow validate --dir server/workflows --strict",
    "check:env": "tsx scripts/check-env.ts",
    "check:env:production": "tsx scripts/check-env.ts --production",
    "setup:supabase": "tsx scripts/setup-supabase.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:server": "node server/dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:workflow": "vitest run --config server/workflows/__tests__/vitest.config.ts --dir server/workflows/__tests__",
    "test:e2e": "vitest run --config server/workflows/__tests__/vitest.config.ts server/workflows/__tests__/integration/public-release.e2e.test.ts",
    "test:tools": "SUPABASE_URL=http://localhost:54321 SUPABASE_SERVICE_ROLE_KEY=test ANTHROPIC_API_KEY=test OPENAI_API_KEY=test tsx --test server/src/services/safe-calendar-client.test.ts server/src/attio/tools/__tests__/tools.test.ts server/src/salesforce/tools/__tests__/tools.test.ts",
    "test:slack-message": "tsx scripts/test/send-mock-slack-message.ts",
    "test:slack-interaction": "tsx scripts/test/send-mock-slack-interaction.ts",
    "test:seed": "tsx --env-file=.env.development scripts/test/seed-test-data.ts",
    "test:seed-features": "tsx --env-file=.env.development scripts/test/seed-feature-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@clerk/backend": "^2.33.6",
    "@clerk/express": "^1.7.82",
    "@clerk/react": "^6.12.11",
    "@langchain/anthropic": "^1.5.3",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.9",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@slack/bolt": "^4.7.3",
    "@slack/web-api": "^7.19.0",
    "@supabase/supabase-js": "^2.112.1",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "exa-js": "^1.10.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.4.0",
    "helmet": "^8.3.0",
    "jsforce": "^3.10.19",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "nitro": "3.0.260610-beta",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.62.4",
    "svix": "^1.99.1",
    "workflow": "^4.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "happy-dom": "^20.11.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.29.0"
    }
  }
}
