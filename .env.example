# ============================================================================
# Slack-Native Sales Agent Harness — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# Never commit a .env file with real credentials.
#
# OAuth redirect URLs you must register:
#   Google (Calendar + Gmail): SERVER_BASE_URL/api/oauth/google/callback
#   Google (Email OAuth): SERVER_BASE_URL/oauth/email/callback
#   Slack workspace install: SERVER_BASE_URL/api/oauth/slack/callback
#   Salesforce: SERVER_BASE_URL/api/salesforce/oauth/callback
#   Attio hosted MCP: SERVER_BASE_URL/api/oauth/attio/callback
#   Granola hosted MCP: SERVER_BASE_URL/api/oauth/granola/callback
# ============================================================================

# --- SERVER ---
SERVER_BASE_URL="http://localhost:3001"                  # e.g. https://your-backend.example.com (no trailing slash)
FRONTEND_URL="http://localhost:5173"                     # e.g. https://your-app.example.com
VITE_APP_URL="http://localhost:5173"                     # same as FRONTEND_URL, used by Vite
VITE_API_URL="http://localhost:3001/api"                 # e.g. https://your-backend.example.com/api
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3001"                  # comma-separated allowed CORS origins (defaults to localhost:*)
PORT="3001"                             # default: 3001

# --- SUPABASE ---
# Create a project at https://supabase.com and find these in Project Settings > API
VITE_SUPABASE_URL=""
SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""    # the "anon" public key
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""        # service role key — never expose in browser
SUPABASE_JWT_SECRET=""              # Project Settings > API > JWT Secret

# --- ANTHROPIC ---
ANTHROPIC_API_KEY=""                # https://console.anthropic.com

# --- OPENAI ---
OPENAI_API_KEY=""                   # https://platform.openai.com — used for embeddings

# --- SLACK ---
# Create a Slack app at https://api.slack.com/apps
# See examples/slack-app-manifest.example.json for required scopes and event subscriptions
SLACK_APP_ID=""                     # App ID from Basic Information
SLACK_CLIENT_ID=""                  # OAuth & Permissions > Client ID
VITE_SLACK_CLIENT_ID=""             # same value, exposed to frontend
SLACK_CLIENT_SECRET=""              # OAuth & Permissions > Client Secret
SLACK_SIGNING_SECRET=""             # Basic Information > Signing Secret
SLACK_TOKEN_ENCRYPTION_KEY=""       # generate with: openssl rand -base64 32
SLACK_BOT_TOKEN=""                  # OAuth & Permissions > Bot Token (xoxb-...) — only for dev
SLACK_ENGINEERING_WEBHOOK_URL=""    # optional: incoming webhook for internal alerts

# --- GOOGLE OAUTH / CALENDAR / GMAIL ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable: Google Calendar API, Gmail API, Cloud Pub/Sub API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""        # SERVER_BASE_URL/api/oauth/google/callback
GOOGLE_CALENDAR_CLIENT_ID=""        # can reuse GOOGLE_CLIENT_ID
VITE_GOOGLE_CALENDAR_CLIENT_ID=""   # same, exposed to frontend
GOOGLE_CALENDAR_CLIENT_SECRET=""    # can reuse GOOGLE_CLIENT_SECRET
GOOGLE_CALENDAR_REDIRECT_URI=""     # SERVER_BASE_URL/api/oauth/google/callback
VITE_GOOGLE_CALENDAR_REDIRECT_URI=""
GMAIL_PUBSUB_TOPIC=""               # Google Cloud Pub/Sub topic for Gmail push notifications

# --- SALESFORCE ---
# Create a Connected App in Salesforce Setup > App Manager
VITE_SALESFORCE_CONSUMER_KEY=""
SALESFORCE_CONNECTED_APP_CLIENT_ID=""
SALESFORCE_CONNECTED_APP_CLIENT_SECRET=""

# --- CLERK (Authentication) ---
# Create an application at https://clerk.com
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""     # Clerk Dashboard > Webhooks > your endpoint
VITE_CLERK_JWT_TEMPLATE=""          # name of the JWT template in Clerk dashboard

# --- INNGEST (Workflow orchestration) ---
# https://app.inngest.com — create an app and copy these keys
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- EXTERNAL APIS / HOSTED MCP ---
EXA_API_KEY=""                      # https://exa.ai — web research for prospect enrichment
GRANOLA_REVOCATION_URL=""           # optional override; discovered OAuth is used for connection
# Attio and Granola client IDs are intentionally absent: their hosted MCP servers
# use OAuth discovery, dynamic client registration, and PKCE.

# --- INTERNAL ---
INTERNAL_API_SECRET=""              # generate with: openssl rand -base64 32
HEALTH_CHECK_SECRET=""              # optional: secret for authenticated /health/deep endpoint

# --- OPTIONAL: Browserbase (browser automation) ---
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""
